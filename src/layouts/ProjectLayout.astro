---
import MainLayout from "./MainLayout.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import type { Project } from "../content/projects";
export interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<MainLayout
  title={`${project.title} — Jose Fernando Gonzales`}
  description={project.description}
>
  <article>
    <header class="container case-header">
      <a class="back-link" href="/projects/">
        ← All work
      </a>
      <div class="case-kicker">
        <span class="eyebrow">
          {project.category} / {project.year}
        </span>
        <span class="status-label">{project.status}</span>
      </div>
      <h1>
        {project.title}
        <span class="blue">.</span>
      </h1>
      <p class="case-headline">{project.headline}</p>
      <div class="case-meta">
        <div>
          <span class="eyebrow">Project access</span>
          <p>{project.access}</p>
        </div>
        <div>
          <span class="eyebrow">Tools & technologies</span>
          <p>{project.stack.join(" / ")}</p>
        </div>
        {project.repoUrl && (
          <a
            class="text-link"
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Explore the source <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </header>
    <div class="container case-visual">
      <ProjectVisual kind={project.slug} />
      <p class="visual-note">
        Concept illustration / A view of the idea, not a product screenshot.
      </p>
    </div>
    <div class="container case-body">
      <aside class="case-sidebar">
        <p class="eyebrow">Inside the build</p>
        <nav aria-label="Case study sections">
          <a href="#context">The context</a>
          <a href="#approach">The approach</a>
          <a href="#decision">A key decision</a>
          <a href="#result">The result</a>
        </nav>
        <a class="text-link" href="/contact/">
          Discuss this work ↗
        </a>
      </aside>
      <div class="case-prose">
        <section id="context">
          <p class="eyebrow">01 / The context</p>
          <h2>
            The problem
            <br />
            worth working on.
          </h2>
          <p>{project.problem}</p>
        </section>
        <section id="approach">
          <p class="eyebrow">02 / The approach</p>
          <h2>
            How the pieces
            <br />
            come together.
          </h2>
          <ol class="approach-list">
            {project.approach.map((paragraph, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <p>{paragraph}</p>
              </li>
            ))}
          </ol>
          <div class="system-flow" aria-label="Conceptual project flow">
            {project.flow.map((step, index) => (
              <>
                <span>{step}</span>
                {index < project.flow.length - 1 && <i aria-hidden="true">→</i>}
              </>
            ))}
          </div>
        </section>
        <section class="decision-section" id="decision">
          <p class="eyebrow">03 / A key decision</p>
          <h2>
            The detail
            <br />
            that shapes the system.
          </h2>
          <p>{project.decision}</p>
        </section>
        <section id="result">
          <p class="eyebrow">04 / The result</p>
          <h2>What came out of it.</h2>
          <p>{project.outcome}</p>
          <div class="scope-note">
            <h3>Scope & limitations</h3>
            <p>{project.boundary}</p>
          </div>
        </section>
        <slot />
      </div>
    </div>
    <div class="container case-end">
      <a class="text-link" href="/projects/">
        ← Back to all work
      </a>
      <a class="btn" href="/contact/">
        Let’s talk about it <span aria-hidden="true">↗</span>
      </a>
    </div>
  </article>
</MainLayout>
