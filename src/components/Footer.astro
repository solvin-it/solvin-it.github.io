---
import { siteConfig } from "../content/site";
---

<footer class="profile-footer site-footer">
  <div class="container profile-footer-main">
    <div>
      <p class="eyebrow">Professional enquiries</p>
      <h2>Get in touch.</h2>
      <a class="profile-email" href={`mailto:${siteConfig.author.email}`}>
        {siteConfig.author.email}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="profile-footer-links">
      <a href="/resume/">Résumé ↗</a>
      <a
        href={siteConfig.author.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn ↗
      </a>
      <a
        href={siteConfig.author.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub ↗
      </a>
      <a href="/contact/">Contact details ↗</a>
    </div>
  </div>
  <div class="container profile-footer-bottom">
    <nav class="profile-legal-links" aria-label="Legal">
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/terms-of-service/">Terms of Service</a>
    </nav>
    <span>© {new Date().getFullYear()} Jose Fernando Gonzales</span>
    <a href={siteConfig.studioUrl} target="_blank" rel="noopener noreferrer">
      <img src="/brand/solvin-mark.svg" width="23" height="23" alt="" /> Also
      behind Solvin <span aria-hidden="true">↗</span>
    </a>
  </div>
</footer>
