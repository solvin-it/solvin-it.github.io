---
import type { Project } from "../content/projects";
import ProjectVisual from "./ProjectVisual.astro";
export interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="work-card" data-category={project.category}>
  <a
    class="work-visual-link"
    href={`/projects/${project.slug}/`}
    tabindex="-1"
    aria-hidden="true"
  >
    <ProjectVisual kind={project.slug} />
  </a>
  <div class="work-meta">
    <span>{project.category}</span>
    <span>
      {project.year} /{" "}
      {project.access === "Private project" ? "Private" : "Public"}
    </span>
  </div>
  <h3>
    <a href={`/projects/${project.slug}/`}>
      {project.title}
      <span aria-hidden="true">↗</span>
    </a>
  </h3>
  <p>{project.description}</p>
  <span class="work-status">{project.status}</span>
</article>
