---
import { siteConfig } from "../content/site";
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Jose Gonzales, home">
      <span class="personal-monogram" aria-hidden="true">
        JG<span>.</span>
      </span>
      <span>
        Jose Gonzales<span class="brand-subtitle">Professional profile</span>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          aria-current={
            (item.href === "/" ? path === "/" : path.startsWith(item.href))
              ? "page"
              : undefined
          }
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="btn btn-small nav-contact" href="/resume/">
        Résumé <span aria-hidden="true">↗</span>
      </a>
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label="Switch color theme"
        title="Switch color theme"
      >
        <svg
          class="moon-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M20.5 14a8.5 8.5 0 0 1-10.5-10.5A8.5 8.5 0 1 0 20.5 14Z" />
        </svg>
        <svg
          class="sun-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
        </svg>
      </button>
      <button
        class="icon-button menu-toggle"
        type="button"
        hidden
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="menu-lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
    {siteConfig.navigation.map((item) => (
      <a
        href={item.href}
        aria-current={
          (item.href === "/" ? path === "/" : path.startsWith(item.href))
            ? "page"
            : undefined
        }
      >
        {item.label}
        <span aria-hidden="true">↗</span>
      </a>
    ))}
    <a href="/resume/">
      Résumé <span aria-hidden="true">↗</span>
    </a>
    <a href="/contact/">
      Contact <span aria-hidden="true">↗</span>
    </a>
    <a href={siteConfig.studioUrl} target="_blank" rel="noopener noreferrer">
      Visit Solvin <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
<script>
  const themeButton =
    document.querySelector<HTMLButtonElement>(".theme-toggle");
  function updateThemeLabel() {
    const dark = document.documentElement.dataset.theme === "dark";
    themeButton?.setAttribute(
      "aria-label",
      `Use ${dark ? "light" : "dark"} theme`,
    );
  }
  updateThemeLabel();
  themeButton?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("solvin-theme", next);
    } catch {}
    updateThemeLabel();
  });
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-nav");
  if (menu) menu.hidden = true;
  if (menuButton) menuButton.hidden = false;
  function closeMenu() {
    if (menu) menu.hidden = true;
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Open navigation");
  }
  menuButton?.addEventListener("click", () => {
    if (!menu) return;
    menu.hidden = !menu.hidden;
    menuButton.setAttribute("aria-expanded", String(!menu.hidden));
    menuButton.setAttribute(
      "aria-label",
      menu.hidden ? "Open navigation" : "Close navigation",
    );
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) {
      closeMenu();
      menuButton?.focus();
    }
  });
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", closeMenu));
  matchMedia("(min-width: 961px)").addEventListener("change", (event) => {
    if (event.matches) closeMenu();
  });
</script>
