---
import MainLayout from "../../layouts/MainLayout.astro";
const notes = [
  {
    number: "01",
    title: "Grounding is a product decision.",
    body: "A cited answer is only one part of a knowledge system. Source versions, review status, and the ability to trace a claim matter just as much as the final response.",
    project: "Solvin GraphRAG",
    slug: "graph-rag",
    category: "AI systems",
  },
  {
    number: "02",
    title: "The interface should fit the task.",
    body: "Conversation is useful when context matters. A direct control is often faster for repetitive work. Giving people both can make an assistant more useful, not less intelligent.",
    project: "Civi",
    slug: "civi",
    category: "Product thinking",
  },
  {
    number: "03",
    title: "Make the tradeoff visible.",
    body: "A recall improvement deserves its precision figure beside it. Good ML communication explains what a model gets wrong, what the threshold changes, and what remains unvalidated.",
    project: "Readmission prediction",
    slug: "diabetic-readmission",
    category: "Applied ML",
  },
  {
    number: "04",
    title: "Connectivity is a design constraint.",
    body: "Field software needs to work where the job happens. Capturing actions locally and making synchronization explicit changes the architecture from the beginning.",
    project: "Oprenta",
    slug: "oprenta",
    category: "Product engineering",
  },
];
---

<MainLayout
  title="Notes on the work — Jose Fernando Gonzales"
  description="Short engineering observations from building AI systems, applications, and ML projects."
>
  <section class="page-intro container">
    <p class="eyebrow">Professional development / Notes</p>
    <h1>
      Engineering notes<span class="blue">.</span>
    </h1>
    <div class="intro-bottom">
      <p>
        Short observations drawn from the projects.
        <br />
        The decisions behind the interface and the code.
      </p>
    </div>
  </section>
  <section class="container notes-list" aria-label="Engineering notes">
    {notes.map((note) => (
      <article id={`note-${note.number}`}>
        <span class="eyebrow">
          {note.number} / {note.category}
        </span>
        <div>
          <h2>{note.title}</h2>
          <p>{note.body}</p>
          <a class="text-link" href={`/projects/${note.slug}/`}>
            Inside {note.project} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </section>
</MainLayout>
