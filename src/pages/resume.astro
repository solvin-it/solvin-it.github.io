---
import MainLayout from "../layouts/MainLayout.astro";
import {
  profile,
  experiences,
  education,
  achievements,
  trainings,
  skillGroups,
} from "../content/profile";
import { projects } from "../content/projects";
---

<MainLayout
  title="Résumé — Jose Fernando Gonzales"
  description="Résumé of Jose Fernando Gonzales. AI development, enterprise data, product engineering, and FinTech."
>
  <section class="page-intro container resume-intro">
    <p class="eyebrow">The details, in one place</p>
    <h1>
      Résumé<span class="blue">.</span>
    </h1>
    <div class="intro-bottom">
      <p>
        Experience, skills, and selected work.
        <br />
        Use your browser’s print dialog to save a PDF.
      </p>
      <button class="btn" type="button" data-print hidden>
        Print / Save as PDF <span aria-hidden="true">↗</span>
      </button>
    </div>
  </section>
  <article class="container resume-document">
    <header class="resume-header">
      <div>
        <h2>{profile.fullName}</h2>
        <p>AI Developer / Enterprise Data & Product Engineering</p>
      </div>
      <div>
        <p>{profile.location}</p>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedin}>LinkedIn ↗</a>
        <a href={profile.github}>GitHub ↗</a>
      </div>
    </header>
    <section class="resume-section">
      <h3>Profile</h3>
      <div>
        {profile.summary.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>
    <section class="resume-section">
      <h3>Experience</h3>
      <div>
        {experiences.map((item) => (
          <article class="resume-job">
            <h4>{item.role}</h4>
            <p class="resume-employer">
              {item.company} · {item.duration}
            </p>
            <p>{item.context}</p>
            <ul>
              {item.achievements.map((achievement) => (
                <li>{achievement}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
    <section class="resume-section">
      <h3>Skills</h3>
      <div>
        {skillGroups.map((group) => (
          <p>
            <strong>{group.category}</strong>
            <br />
            {group.skills.join(" · ")}
          </p>
        ))}
      </div>
    </section>
    <section class="resume-section">
      <h3>Selected projects</h3>
      <div>
        {projects.slice(0, 5).map((project) => (
          <div class="resume-project">
            <h4>
              <a href={`/projects/${project.slug}/`}>{project.title} ↗</a>
            </h4>
            <p>{project.description}</p>
            <span class="muted">
              {project.status} · {project.access}
            </span>
          </div>
        ))}
      </div>
    </section>
    <section class="resume-section">
      <h3>Education</h3>
      <div>
        {education.map((item) => (
          <p>
            <strong>{item.degree}</strong>
            <br />
            {item.school} · {item.duration}
            <br />
            {item.detail}
          </p>
        ))}
      </div>
    </section>
    <section class="resume-section">
      <h3>Achievements</h3>
      <ul>
        {achievements.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
    <section class="resume-section">
      <h3>Additional training</h3>
      <ul>
        {trainings.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  </article>
</MainLayout>
<script>
  const printButton = document.querySelector<HTMLButtonElement>("[data-print]");
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener("click", () => window.print());
  }
</script>
