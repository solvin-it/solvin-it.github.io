---
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../content/projects";
const categories = [
  "All work",
  "AI systems",
  "Product engineering",
  "Applied ML",
];
---

<MainLayout
  title="Selected work — Jose Fernando Gonzales"
  description="Independent products, AI systems, and applied ML. Explore the problem, the engineering decisions, and the limits of each project."
>
  <section class="page-intro container">
    <p class="eyebrow">Curriculum vitae / Project portfolio</p>
    <h1>
      Projects &amp; case studies<span class="blue">.</span>
    </h1>
    <div class="intro-bottom">
      <p>
        Selected independent and academic work in AI, software engineering, and
        machine learning.
        <br />
        The technical approach, key decisions, and scope of each project.
      </p>
      <span class="eyebrow">{projects.length} projects / A closer look</span>
    </div>
  </section>
  <section class="container projects-section" aria-label="Project collection">
    <div
      class="filter-bar"
      data-filters
      hidden
      role="group"
      aria-label="Filter projects by discipline"
    >
      {categories.map((category, index) => (
        <button
          type="button"
          class="filter-button"
          aria-pressed={index === 0 ? "true" : "false"}
          data-filter={category}
        >
          {category}
          <span>
            {index === 0
              ? projects.length
              : projects.filter((project) => project.category === category)
                  .length}
          </span>
        </button>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
    <div class="work-grid all-work">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    <div class="collection-note">
      <span class="eyebrow">A note on private work</span>
      <p>
        Private projects are described at a product and engineering level.
        Source code, customer information, and internal documents remain
        private. Illustrations are conceptual, not product screenshots.
      </p>
    </div>
  </section>
</MainLayout>
<script>
  const filters = document.querySelector<HTMLElement>("[data-filters]");
  if (filters) filters.hidden = false;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>(
    ".work-card[data-category]",
  );
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const category = button.dataset.filter;
      buttons.forEach((item) =>
        item.setAttribute("aria-pressed", String(item === button)),
      );
      let count = 0;
      cards.forEach((card) => {
        card.hidden =
          category !== "All work" && card.dataset.category !== category;
        if (!card.hidden) count++;
      });
      const status = document.querySelector("[data-filter-status]");
      if (status)
        status.textContent = `Showing ${count} ${category === "All work" ? "projects" : category + " projects"}.`;
    }),
  );
</script>
