---
import MainLayout from "../layouts/MainLayout.astro";
import {
  profile,
  experiences,
  education,
  skillGroups,
} from "../content/profile";
import { getProject } from "../content/projects";
const selectedProjects = [
  "graph-rag",
  "oprenta",
  "diabetic-readmission",
  "pos-system",
].map(getProject);
const current = experiences[0];
const sections = [
  ["overview", "Overview"],
  ["career", "Experience"],
  ["expertise", "Skills"],
  ["selected-projects", "Projects"],
  ["education", "Education"],
];
---

<MainLayout>
  <div class="container cv-page">
    <header class="cv-identity">
      <div class="cv-name-block">
        <p class="eyebrow">Professional profile / Curriculum vitae</p>
        <h1>
          Jose Fernando
          <br />
          Gonzales<span class="blue">.</span>
        </h1>
        <p class="cv-role">AI Developer</p>
        <p class="cv-specialism">Enterprise data · Agentic AI · FinTech</p>
        <div class="cv-mobile-actions">
          <a class="btn" href="/resume/">
            View résumé / PDF <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/contact/">
            Contact <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="cv-current">
        <p class="eyebrow">
          <span class="signal-dot"></span> Current position
        </p>
        <h2>JPMorganChase</h2>
        <p>{current.role}</p>
        <span>Consumer &amp; Community Banking</span>
        <div class="cv-current-date">December 2025 — Present</div>
        <a href="/experience/" class="text-link">
          View experience <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <div class="cv-document-grid">
      <aside class="cv-rail" aria-label="Profile directory">
        <div class="cv-rail-top">
          <span class="eyebrow">On this page</span>
          <nav aria-label="Profile sections">
            {sections.map(([id, label], index) => (
              <a href={`#${id}`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {label}
              </a>
            ))}
          </nav>
        </div>
        <dl class="cv-facts">
          <div>
            <dt>Based in</dt>
            <dd>Makati, Philippines</dd>
          </div>
          <div>
            <dt>Experience</dt>
            <dd>2016 — present</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>AI &amp; enterprise systems</dd>
          </div>
        </dl>
        <a href="/resume/" class="btn cv-resume-link">
          Full résumé <span aria-hidden="true">↗</span>
        </a>
        <div class="cv-socials">
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn ↗
          </a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
          <a href={`mailto:${profile.email}`}>Email ↗</a>
        </div>
      </aside>
      <div class="cv-main">
        <section id="overview" class="cv-section cv-overview">
          <div class="cv-section-heading">
            <span class="eyebrow">01 / Overview</span>
          </div>
          <p class="cv-lead">
            I build AI-powered data and reporting systems, backed by a decade in
            FinTech and enterprise technology.
          </p>
          <p>
            My background spans SAP consulting, business analysis, payment
            platforms, and now hands-on AI development at JPMorganChase. That
            experience shapes how I work: understand the business, work through
            the constraints, and build a solution people can use.
          </p>
          <p>
            Today, my focus is agentic workflows, ETL migration, RAG, and
            conversational access to data. Alongside my professional work, I
            develop independent applications through Solvin.
          </p>
          <div class="cv-impact">
            <p class="eyebrow">Selected contributions / Current role</p>
            <div class="cv-impact-grid">
              <article>
                <strong>
                  Up to 99<span>%</span>
                </strong>
                <p>
                  Fewer development hours for Alteryx-to-AWS Glue workflow
                  conversion.
                </p>
              </article>
              <article>
                <strong>Weeks → hours</strong>
                <p>
                  Dashboard creation time in an agentic reporting prototype.
                </p>
              </article>
            </div>
            <a class="text-link" href="/experience/">
              Read the role and context <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
        <section id="career" class="cv-section">
          <div class="cv-section-heading">
            <div>
              <span class="eyebrow">02 / Professional experience</span>
              <h2>Career progression</h2>
            </div>
            <a href="/experience/" class="text-link">
              Full history <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="cv-career-list">
            {experiences.slice(0, 5).map((experience, index) => (
              <article
                class:list={["cv-career-item", { "is-current": index === 0 }]}
              >
                <span class="cv-career-dot" aria-hidden="true"></span>
                <div class="cv-career-meta">
                  <span>{experience.duration}</span>
                  {index === 0 && <span class="cv-current-tag">Current</span>}
                </div>
                <h3>{experience.role}</h3>
                <p class="cv-employer">{experience.company}</p>
                <p class="cv-career-description">{experience.description}</p>
              </article>
            ))}
          </div>
        </section>
        <section id="expertise" class="cv-section">
          <div class="cv-section-heading">
            <div>
              <span class="eyebrow">
                03 / Technical &amp; professional skills
              </span>
              <h2>Areas of expertise</h2>
            </div>
          </div>
          <div class="cv-skill-list">
            {skillGroups.map((group) => (
              <div>
                <h3>{group.category}</h3>
                <p>{group.skills.join(" · ")}</p>
              </div>
            ))}
          </div>
        </section>
        <section id="selected-projects" class="cv-section">
          <div class="cv-section-heading">
            <div>
              <span class="eyebrow">04 / Applied experience</span>
              <h2>Selected projects</h2>
            </div>
            <a class="text-link" href="/projects/">
              All projects <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="cv-section-note">
            Independent and academic work that puts my skills into practice.
            Private projects are shared as high-level case studies.
          </p>
          <div class="cv-project-list">
            {selectedProjects.map((project, index) => (
              <article>
                <span class="cv-project-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <div class="cv-project-meta">
                    <span>{project.category}</span>
                    <span>
                      {project.access === "Private project"
                        ? "Private source"
                        : "Public source"}
                    </span>
                  </div>
                  <h3>
                    <a href={`/projects/${project.slug}/`}>
                      {project.title}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  <p>{project.description}</p>
                  <div class="cv-project-stack">
                    {project.stack.slice(0, 4).join(" / ")}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
        <section id="education" class="cv-section">
          <div class="cv-section-heading">
            <div>
              <span class="eyebrow">05 / Education &amp; recognition</span>
              <h2>Academic foundation</h2>
            </div>
          </div>
          <div class="cv-education-list">
            {education.map((item) => (
              <article>
                <span>{item.duration}</span>
                <h3>{item.degree}</h3>
                <p>{item.school}</p>
                <p class="cv-education-detail">{item.detail}</p>
              </article>
            ))}
          </div>
          <div class="cv-recognition">
            <span class="eyebrow">Earlier recognition</span>
            <p>
              <strong>2015</strong> YSDA international hackathon — led the
              winning team.
            </p>
            <p>
              <strong>2014</strong> DevCon Java Programming Champion.
            </p>
          </div>
        </section>
        <div class="cv-closing">
          <div>
            <h2>The complete picture.</h2>
            <p>
              Career history, contributions, training, and selected work in a
              printable résumé.
            </p>
          </div>
          <a class="btn" href="/resume/">
            Read my résumé <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
