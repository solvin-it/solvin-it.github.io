---
import MainLayout from "../layouts/MainLayout.astro";
import { experiences, education, skillGroups } from "../content/profile";
---

<MainLayout
  title="Experience — Jose Fernando Gonzales"
  description="A decade across AI development, FinTech, enterprise systems, and technical delivery. The experience behind the work."
>
  <section class="page-intro container">
    <p class="eyebrow">Curriculum vitae / Experience</p>
    <h1>
      Professional experience<span class="blue">.</span>
    </h1>
    <div class="intro-bottom">
      <p>
        AI development, FinTech, and enterprise systems.
        <br />
        Roles, responsibilities, and contributions from 2016 to the present.
      </p>
      <a class="text-link" href="/resume/">
        Read my résumé <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="container timeline" aria-label="Professional experience">
    {experiences.map((experience, index) => (
      <article class="timeline-item">
        <div class="timeline-date">
          <span class="eyebrow">
            {String(index + 1).padStart(2, "0")} /{" "}
            {experience.type === "current" ? "Current" : "Previously"}
          </span>
          <p>{experience.duration}</p>
          <span>{experience.location}</span>
        </div>
        <div class="timeline-content">
          <h2>{experience.role}</h2>
          <p class="timeline-company">
            {experience.company}
            <span> / {experience.context}</span>
          </p>
          <p>{experience.description}</p>
          <details open={experience.type === "current"}>
            <summary>
              Selected contributions <span aria-hidden="true">+</span>
            </summary>
            <ul>
              {experience.achievements.map((achievement) => (
                <li>{achievement}</li>
              ))}
            </ul>
          </details>
          <div class="tags">
            {experience.technologies.map((technology) => (
              <span>{technology}</span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Skills</p>
        <h2>Technical &amp; professional expertise</h2>
      </div>
    </div>
    <div class="skills-list">
      {skillGroups.map((group) => (
        <div>
          <h3>{group.category}</h3>
          <p>{group.skills.join(" · ")}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="education-section">
    <div class="container">
      <p class="eyebrow">Education</p>
      {education.map((item) => (
        <article>
          <div>
            <h3>{item.degree}</h3>
            <p>{item.school}</p>
          </div>
          <div>
            <p>{item.duration}</p>
            <span>{item.detail}</span>
          </div>
        </article>
      ))}
    </div>
  </section>
</MainLayout>
