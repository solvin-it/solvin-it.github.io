---
import MainLayout from "../layouts/MainLayout.astro";
import { siteConfig } from "../content/site";
---

<MainLayout
  title="Let’s talk — Jose Fernando Gonzales"
  description="Get in touch with Jose Fernando Gonzales about AI systems, product engineering, or collaboration."
>
  <section class="page-intro container">
    <p class="eyebrow">Curriculum vitae / Contact</p>
    <h1>
      Contact<span class="blue">.</span>
    </h1>
    <div class="intro-bottom">
      <p>
        For professional opportunities, technical discussions, and
        collaboration.
        <br />
        Email or connect with me on LinkedIn.
      </p>
      <span class="eyebrow">Makati, Philippines / UTC+8</span>
    </div>
  </section>
  <section class="container contact-layout">
    <div>
      <p class="eyebrow">Start here</p>
      <h2>Write to Jose.</h2>
      <p class="contact-description">
        For role enquiries, please include the team, responsibilities, and
        relevant details. For questions about my experience or projects, a brief
        introduction is welcome.
      </p>
      <a class="contact-email" href={`mailto:${siteConfig.author.email}`}>
        {siteConfig.author.email}
        <span aria-hidden="true">↗</span>
      </a>
      <button
        type="button"
        class="text-link copy-email"
        data-email={siteConfig.author.email}
        hidden
      >
        Copy email address <span aria-hidden="true">⧉</span>
      </button>
      <p class="copy-status" role="status" data-copy-status></p>
    </div>
    <div class="contact-links">
      <a
        href={siteConfig.author.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div>
          <span class="eyebrow">Connect</span>
          <h3>LinkedIn</h3>
          <p>Professional background and conversation.</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
      <a
        href={siteConfig.author.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div>
          <span class="eyebrow">Explore</span>
          <h3>GitHub</h3>
          <p>Public projects and the source behind them.</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
      <a href={siteConfig.studioUrl} target="_blank" rel="noopener noreferrer">
        <div>
          <span class="eyebrow">Independent practice</span>
          <h3>Solvin</h3>
          <p>My separate website for Solvin and its services.</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</MainLayout>
<script>
  const copy = document.querySelector<HTMLButtonElement>(".copy-email");
  if (copy && navigator.clipboard) copy.hidden = false;
  copy?.addEventListener("click", async () => {
    const status = document.querySelector("[data-copy-status]");
    try {
      await navigator.clipboard.writeText(copy.dataset.email || "");
      if (status) status.textContent = "Email address copied.";
    } catch {
      if (status)
        status.textContent =
          "Could not copy. Select the email address above to copy it manually.";
    }
  });
</script>
